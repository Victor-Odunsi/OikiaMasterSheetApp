# Application Settings
APP_NAME="Church Usher System"
DEBUG=False

# Security (CHANGE THESE IN PRODUCTION!)
JWT_SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_HOURS=8

# Password Reset
RESET_TOKEN_EXPIRATION_HOURS=1

# Database
SQLITE_DATABASE_URL="sqlite:///./users.db"

# Google Sheets
GOOGLE_SHEETS_ID="your-google-sheet-id-here"
GOOGLE_CREDENTIALS_FILE="credentials.json"
SHEET_NAME="Sheet1"

# Cache Settings
CACHE_TTL_MINUTES=5

# Email Settings (SMTP)
# For Gmail: Use App Password (not your regular password!)
# Enable 2FA, then generate App Password at: https://myaccount.google.com/apppasswords
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"
FROM_EMAIL="your-email@gmail.com"
FROM_NAME="Church Usher System"

# Frontend URL (for password reset links)
FRONTEND_URL="http://localhost:3000"

# CORS (Add your frontend URLs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://your-frontend-domain.vercel.app"]
